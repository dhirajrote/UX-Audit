# Copy this file to .env and fill in real values.
# Used by the /api serverless functions only — never exposed to the browser.

# Anthropic (powers the AI Assistant + per-issue Generate buttons)
ANTHROPIC_API_KEY=

# Supabase (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Login (single-user basic auth — see README for setup notes)
AUTH_USERNAME=dheerajrote
AUTH_PASSWORD=Qwerty123!@#
# Any long random string — used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
