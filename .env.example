# Copy this file to .env and fill in real values.
# Used by the /api serverless functions only — never exposed to the browser.
#
# IMPORTANT: This file is a TEMPLATE and gets committed to the (public) repo.
# Never fill in real values here — put real secrets only in your local .env
# (already gitignored) and in Vercel's Environment Variables dashboard.

# Anthropic (powers the AI Assistant + per-issue Generate buttons)
ANTHROPIC_API_KEY=

# Supabase (Project Settings -> API). Use the base project URL, no /rest/v1/ suffix.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Login — username/password are hardcoded in api/auth.js (dheerajrote / Qwerty123!@#).
# Since this repo is public, that means they are NOT secret. Leave these two
# blank to use the hardcoded defaults, or set them here/in Vercel to override
# without touching code (overrides take priority over the hardcoded values).
AUTH_USERNAME=
AUTH_PASSWORD=
# Required. Any long random string — used to sign session cookies, and must
# stay private (never hardcode this one, never commit a real value here).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
